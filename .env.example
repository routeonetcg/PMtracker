# ---- Supabase (Project Settings → API / Data API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never expose. Used by the daily price job and photo signing.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---- Postgres (Project Settings → Database → Connection string → Transaction pooler, port 6543) ----
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ---- App ----
APP_TIMEZONE=America/New_York
# Protects the daily price job (/api/cron/prices). Any long random string: openssl rand -hex 32
CRON_SECRET=

# ---- Prices ----
# Optional, paid (PriceCharting Legendary plan): graded, Japanese and sealed prices.
PRICECHARTING_TOKEN=
# LOCAL DEVELOPMENT ONLY: 1 = use built-in sample price responses (made-up prices). Never set in production.
# PRICE_FIXTURES=1

# ---- Partners (used by `pnpm db:seed` to create the two partner records) ----
PARTNER_1_NAME=Partner One
PARTNER_1_EMAIL=partner1@example.com
PARTNER_2_NAME=Partner Two
PARTNER_2_EMAIL=partner2@example.com
# Only used when seeding a LOCAL database to create logins. In production create the users in Supabase → Authentication.
PARTNER_PASSWORD=change-me-please
